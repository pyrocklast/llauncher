<?xml version="1.0" encoding="utf-8"?>
<!-- Lite: size dialog. The preview shows your home apps, or the clock and date, at the size the
     slider is on. Their sizes here match the home screen's at 100%. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp">

    <TextView
        android:id="@+id/textSizePreview"
        style="@style/TextLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:shadowRadius="0"
        android:textColor="?attr/colorOnSurface" />

    <TextClock
        android:id="@+id/clockPreview"
        style="@style/TextDefault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:format12Hour="h:mm"
        android:maxLines="1"
        android:shadowRadius="0"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/time_size"
        android:visibility="gone" />

    <TextView
        android:id="@+id/datePreview"
        style="@style/TextDefault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="3dp"
        android:shadowRadius="0"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/date_size"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textSizeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/lite_text_size_hint"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.slider.Slider
        android:id="@+id/textSizeSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:stepSize="10"
        android:valueFrom="50"
        android:valueTo="150"
        app:labelBehavior="floating" />

</LinearLayout>
